# Modèle pour .env.production sur le VPS (jamais committé, voir .gitignore).
# Différence avec .env.local : `postgres`/`minio` comme host au lieu de
# `localhost` — l'app tourne dans le même réseau Docker que ces services
# (voir docker-compose.yml, service `app`), donc elle les joint par leur nom
# de service, pas par un port publié sur l'hôte. Voir docs/GETTING_STARTED.md
# §12 pour la procédure complète.

# Doit correspondre exactement à POSTGRES_PASSWORD ci-dessous.
DATABASE_URL=postgres://postgres:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/fbms

# Doit correspondre exactement au mot de passe choisi dans
# db/app_role_setup.sql (créé manuellement sur le VPS, jamais committé).
APP_DATABASE_URL=postgres://app:CHANGE_ME_APP_PASSWORD@postgres:5432/fbms

# Mot de passe superutilisateur Postgres — utilisé par le service `postgres`
# de docker-compose.yml (substitution ${POSTGRES_PASSWORD}) ET doit
# correspondre à celui dans DATABASE_URL ci-dessus.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Doit correspondre exactement à client_auth.audience configuré sur
# l'instance PowerSync Cloud (voir docs/GETTING_STARTED.md §4).
POWERSYNC_JWT_AUDIENCE=CHANGE_ME_POWERSYNC_AUDIENCE

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=expense-photos
MINIO_USE_SSL=false

# Identifiants du serveur MinIO lui-même (service `minio` de
# docker-compose.yml) — doivent être identiques à MINIO_ACCESS_KEY/
# MINIO_SECRET_KEY ci-dessus.
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# URL publique de l'instance PowerSync Cloud reconfigurée pour ce VPS (voir
# docs/GETTING_STARTED.md §4) — inlinée dans le JS client au moment du
# build (voir docker-compose.yml, service `app`, args de build).
NEXT_PUBLIC_POWERSYNC_URL=CHANGE_ME_POWERSYNC_INSTANCE_URL

# Nom de domaine pointant vers l'IP du VPS — Caddy obtient automatiquement
# un certificat HTTPS (Let's Encrypt) pour ce domaine.
DOMAIN=CHANGE_ME.example.com
